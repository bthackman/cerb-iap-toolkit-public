# Copy to pipeline/.env and fill in. Never commit .env.
# Personal access token: https://airtable.com/create/tokens (see airtable/AIRTABLE-SCHEMA.md for scopes)
AIRTABLE_TOKEN=
# The app... part of your CERB base's URL
AIRTABLE_BASE_ID=
# Optional: a Markdown-notes folder (e.g. an Obsidian vault) for generate_dashboard.py's
# progress note and content_to_vault.py. Leave unset to skip those steps.
# CERB_VAULT_DIR=/path/to/your/notes
